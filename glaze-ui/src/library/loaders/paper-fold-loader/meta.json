{
  "id": "paper-fold-loader",
  "name": "Paper Fold Loader",
  "category": "loader",
  "description": "A crisp paper sheet that folds and refolds in a minimalist loop.",
  "directoryPath": "/library/loaders/paper-fold-loader",
  "settingsConfig": [
    { "id": "message", "label": "Loading Text", "type": "text", "default": "Preparing the paper" },
    { "id": "tone", "label": "Paper Tone", "type": "select", "options": ["Kraft", "Ivory", "Parchment"], "default": "Parchment" },
    { "id": "speed", "label": "Fold Speed", "type": "slider", "min": 0.35, "max": 2.5, "default": 1 },
    { "id": "thickness", "label": "Paper Thickness", "type": "slider", "min": 1, "max": 10, "default": 4 }
  ]
}